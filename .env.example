# =============================================================
# SebessegBot - Hyperliquid konfigurációs sablon
# Másold le ezt a fájlt .env névre és töltsd ki az értékeket
# cp .env.example .env
# =============================================================

# Hyperliquid privát kulcs (SOHA ne commitold be!)
PRIVATE_KEY=0x_id_be_a_sajat_private_kulcsodat

# Kereskedési mód: true = szimuláció, false = éles
DRY_RUN=false

# Hálózat: true = mainnet, false = testnet
IS_MAINNET=true

# Fallback egyenleg (USD), ha HL nem kérhető le; DRY_RUN-nál ez a méret
STARTING_EQUITY_USD=100

# true = méret a Hyperliquid számla accountValue-jából (clearinghouseState); false = csak STARTING_EQUITY_USD
USE_WALLET_BALANCE_FOR_SIZING=true

# HL egyenleg frissítése másodpercenként (méret követése); minimum 10
WALLET_EQUITY_REFRESH_SEC=30

# (Opcionális) Builder / másodlagos perp DEX neve. Üres = alap HL perp (nincs dex mező a clearinghouse kérésben).
# Ha a weben van egyenleg, de a bot 0-t lát, gyakran rossz DEX vagy nem ugyanaz a cím mint a Portfolio-n.
# HL_PERP_DEX=

# (Opcionális) Hyperliquid fő / Portfolio cím az INFO API-hoz és user WebSockethez, ha a PRIVATE_KEY egy API (agent) kulcs
# és más a címe, mint ahol a tőke és a pozíció látszik a weben. Üres = ugyanaz, mint az aláíró cím.
# HL_USER_ADDRESS=0x_a_teljes_master_cimet_ide

# Stratégia config fájl
STRATEGY_CONFIG=strategy_maker.json