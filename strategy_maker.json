{
    "strategy_name": "pm_ambush_ladder_maker_v2",
    "strategy_type": "MAKER_ONLY_PRO",
    "signal_engine": {
        "debounce": {
            "min_time_between_entries_ms": 5000
        }
    },
    "order_management": {
        "mode": "ambush_ladder_maker",
        "entry": {
            "type": "dynamic_vol_ladder",
            "reference_price": "mid",
            "sigma_multiplier": 1.5,
            "min_level_gap_ticks": 5,
            "ladder_config": [
                {
                    "level": 1,
                    "offset_from_mid_ticks": 0,
                    "size_pct": 0.4
                },
                {
                    "level": 2,
                    "offset_from_mid_ticks": 0,
                    "size_pct": 0.3
                },
                {
                    "level": 3,
                    "offset_from_mid_ticks": -1,
                    "size_pct": 0.3
                }
            ],
            "signal_params": {
                "z_threshold": 1.8,
                "comment": "1.8 sigma = érzékenyebb jel; 5s debounce"
            },
            "execution": {
                "post_only": true,
                "time_in_force": "GTX"
            }
        },
        "exit": {
            "take_profit": {
                "enabled": true,
                "min_profit_ticks": 12,
                "min_sl_ticks": 20,
                "max_profit_ticks": 500
            }
        }
    },
    "risk_management": {
        "position_limits": {
            "max_open_positions": 1,
            "max_notional_usd_per_trade": 40,
            "balance_pct_per_trade": 4.0,
            "comment": "~$100 számla: 4% × 10x = $40 (cap) → szintenkint $16/$12/$12, mind > HL $10 min"
        },
        "leverage": {
            "max_leverage": 10,
            "cross_margin": false
        },
        "daily_limits": {
            "max_daily_loss_usd": 10,
            "max_daily_trades": 25
        }
    },
    "technical_precision": {
        "tick_size": 0.01,
        "min_shares": 0.001,
        "rounding": {
            "price_formula": "round(price / tick_size) * tick_size",
            "size_formula": "max(min_shares, floor(size * 1e4) / 1e4)"
        }
    }
}