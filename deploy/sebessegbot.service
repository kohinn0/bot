# Hyperliquid SebessegBot – systemd (SSH bezárása után is fut, crash után újraindul)
#
# Telepítés:
#   sudo cp deploy/sebessegbot.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/sebessegbot.service   # User + útvonalak!
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sebessegbot
#
# Állapot / miért állt meg:
#   sudo systemctl status sebessegbot
#   journalctl -u sebessegbot -n 80 --no-pager
#   journalctl -u sebessegbot -f
#
# Leállítás (szándékosan): sudo systemctl stop sebessegbot

[Unit]
Description=SebessegBot Hyperliquid (Rust)
After=network-online.target
Wants=network-online.target
# StartLimit* csak [Unit]-ban érvényes (régebbi systemd „Unknown key” hiba elkerülése)
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sebessegbot/rust_bot
ExecStart=/home/ubuntu/sebessegbot/rust_bot/target/release/sebessegbot_rs

# Bármilyen kilépés után újraindul (kivéve: systemctl stop)
Restart=always
RestartSec=20

KillSignal=SIGTERM
TimeoutStopSec=45

# Napló: journal + fájl (könnyebb grep)
StandardOutput=append:/home/ubuntu/sebessegbot/rust_bot/bot.log
StandardError=append:/home/ubuntu/sebessegbot/rust_bot/bot.log

[Install]
WantedBy=multi-user.target
